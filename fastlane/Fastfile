default_platform(:ios)

platform :ios do
  desc "Build FizyoKantik and upload directly to TestFlight"
  lane :beta do
    # 1. CI için şifresi bilinen özel Keychain (Anahtarlık) oluştur
    keychain_name = "ci_keychain"
    keychain_password = "fizyokantik_pass"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # 2. Apple App Store Connect API Yetkilendirmesi
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 3. Sertifikayı al / oluştur ve ci_keychain içine yükle
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    # 4. Provisioning Profile'ı Apple'dan indir
    profile_path = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.fizyokantik.app"
    )

    # 5. İndirilen Apple Profilinden Team ID'yi otomatik oku ve projeye bağla
    profile_content = sh("security cms -D -i '#{profile_path}'")
    team_id = profile_content[/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([A-Z0-9]+)<\/string>/, 1]
    UI.message("Apple Developer Team ID otomatik tespit edildi: #{team_id}")

    update_project_team(
      path: "FizyoKantik.xcodeproj",
      teamid: team_id
    )

    update_code_signing_settings(
      path: "FizyoKantik.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution"
    )

    # 6. .ipa Paketini Derle
    build_app(
      project: "FizyoKantik.xcodeproj",
      scheme: "FizyoKantik",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "FizyoKantik.ipa"
    )

    # 7. TestFlight'a Yükle
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

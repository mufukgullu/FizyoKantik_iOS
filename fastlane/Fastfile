default_platform(:ios)

platform :ios do
  desc "Build FizyoKantik and upload directly to TestFlight"
  lane :beta do
    # 1. CI ortamını (Keychain, yetkiler vb.) otomatik olarak ayarla
    setup_ci

    # 2. Apple App Store Connect API Yetkilendirmesi
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 3. Sertifikayı Apple Developer hesabından al / oluştur
    get_certificates(api_key: api_key)

    # 4. Provisioning Profile'ı Apple'dan indir
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.fizyokantik.app"
    )

    # 5. .ipa Paketini Derle
    build_app(
      project: "FizyoKantik.xcodeproj",
      scheme: "FizyoKantik",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "FizyoKantik.ipa"
    )

    # 6. TestFlight'a Yükle
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
